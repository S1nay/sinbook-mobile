{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "jsx": "react-native",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "moduleResolution": "NodeNext",
    "types": ["@types/react"],
    "resolveJsonModule": true,
    "paths": {
      "@data/*": ["./src/data/*"],
      "@domain/*": ["./src/domain/*"],
      "@presentation": ["./src/presentation/*"],
      "@core": ["./src/core/*"]
    }
  },
  "exclude": ["node_modules"]
}
